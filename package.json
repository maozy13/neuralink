{
  "name": "neuralink",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "demo": "pnpm build && tsc -p demo/tsconfig.json && node dist/demo/demo.js",
    "demo:chat": "pnpm build && tsc -p demo/tsconfig.json && node dist/demo/chat-completions-demo.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.7",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
